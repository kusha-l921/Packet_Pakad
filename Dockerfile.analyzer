FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    tshark \
    libpcap-dev \
    tcpdump \
    gcc \
    iproute2 \
    procps \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    scapy \
    pyshark \
    cryptography \
    numpy \
    scipy \
    pandas \
    scikit-learn \
    joblib

WORKDIR /workspace

CMD ["tail", "-f", "/dev/null"]