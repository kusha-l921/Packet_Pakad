#!/usr/bin/env python3
"""Compatibility CLI runner for pytest."""

import sys
import time
import unittest
from pathlib import Path

# Ensure repo root and rag_report_generator are on sys.path
cwd = Path.cwd()
if str(cwd) not in sys.path:
    sys.path.insert(0, str(cwd))

def main():
    start_time = time.time()
    args = sys.argv[1:]
    verbose = "-v" in args or "--verbose" in args

    # Discover test files
    start_dir = "rag_report_generator/tests" if Path("rag_report_generator/tests").exists() else "tests"
    for arg in args:
        if not arg.startswith("-") and Path(arg).exists():
            start_dir = arg
            break

    loader = unittest.TestLoader()
    if Path(start_dir).is_file():
        suite = loader.discover(str(Path(start_dir).parent), pattern=Path(start_dir).name)
    else:
        suite = loader.discover(start_dir, pattern="test_*.py")

    total_tests = suite.countTestCases()

    print("============================= test session starts ==============================")
    print(f"platform {sys.platform} -- Python {sys.version.split()[0]}")
    print(f"rootdir: {cwd}")
    print(f"collected {total_tests} items\n")

    passed = 0
    failed = 0
    errors = 0

    class PytestTestResult(unittest.TestResult):
        def addSuccess(self, test):
            super().addSuccess(test)
            nonlocal passed
            passed += 1
            if verbose:
                mod = test.__class__.__module__
                cls = test.__class__.__name__
                name = test._testMethodName
                print(f"{mod}::{cls}::{name} PASSED")
            else:
                sys.stdout.write(".")
                sys.stdout.flush()

        def addFailure(self, test, err):
            super().addFailure(test, err)
            nonlocal failed
            failed += 1
            if verbose:
                mod = test.__class__.__module__
                cls = test.__class__.__name__
                name = test._testMethodName
                print(f"{mod}::{cls}::{name} FAILED")
            else:
                sys.stdout.write("F")
                sys.stdout.flush()

        def addError(self, test, err):
            super().addError(test, err)
            nonlocal errors
            errors += 1
            if verbose:
                mod = test.__class__.__module__
                cls = test.__class__.__name__
                name = test._testMethodName
                print(f"{mod}::{cls}::{name} ERROR")
            else:
                sys.stdout.write("E")
                sys.stdout.flush()

    runner_result = PytestTestResult()
    suite.run(runner_result)

    if not verbose:
        print()

    duration = time.time() - start_time

    if runner_result.failures or runner_result.errors:
        print("\n=================================== FAILURES ===================================")
        for test, traceback in runner_result.failures:
            print(f"___________________ {test} ___________________")
            print(traceback)
        for test, traceback in runner_result.errors:
            print(f"___________________ {test} (ERROR) ___________________")
            print(traceback)

    print(f"\n======================== {passed} passed, {failed} failed in {duration:.2f}s ========================")
    return 0 if (failed == 0 and errors == 0) else 1


if __name__ == "__main__":
    sys.exit(main())
